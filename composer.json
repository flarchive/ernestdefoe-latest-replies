{
    "name": "ernestdefoe/latest-replies",
    "description": "Latest Replies: a widget of the newest replies on your forum, in the sidebar, at the top of the discussion list or beside a discussion. Follows the tag you are viewing, updates live with Realtime, and only ever shows what the reader may see.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "widget",
        "latest posts",
        "recent replies",
        "activity",
        "sidebar"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/latest-replies",
    "support": {
        "issues": "https://github.com/ernestdefoe/latest-replies/issues",
        "source": "https://github.com/ernestdefoe/latest-replies"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\LatestReplies\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\LatestReplies\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Latest Replies",
            "category": "feature",
            "icon": {
                "name": "fas fa-comments",
                "backgroundColor": "#4d698e",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags",
                "flarum/realtime",
                "flarum/approval",
                "fof/byobu",
                "fof/ignore-users"
            ]
        }
    },
    "require-dev": {
        "flarum/approval": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "fof/byobu": "^2.0",
        "fof/ignore-users": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
